# .env.example — variables de entorno operativas.
# Copiá este archivo a .env (está en .gitignore) y ajustá los valores.
# La descarga de datos públicos NO requiere autenticación. Las keys de abajo
# son opcionales y sólo se usan para traducir con una API externa.

DATA_DIR=./data
MLFLOW_TRACKING_URI=sqlite:///./mlruns.db
PYTHONHASHSEED=42

# Traducción EN→ES vía NVIDIA NIM (Nemotron). Key gratis en https://build.nvidia.com
NVIDIA_API_KEY=
